@model IEnumerable<ecommerce_system.Models.Proudect>

@{
    ViewData["Title"] = "products list";
}

<div class="container py-5" dir="rtl">
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold" style="color: #2c3e50;">
                <i class="fas fa-box-open me-2 text-primary"></i> products list
            </h2>
            <p class="text-muted">manage all products in your store</p>
        </div>
        <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm" style="border-radius: 10px;">
            <i class="fas fa-plus me-2"></i> add new product
        </a>
    </div>


    <div class="card border-0 shadow-lg" style="border-radius: 15px; overflow: hidden;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-borderless align-middle text-center mb-0">
                    <thead class="table-light text-muted">
                        <tr>
                            <th class="py-3 px-4">image</th>
                            <th class="py-3">product name</th>
                            <th class="py-3">description</th>
                            <th class="py-3">price</th>
                            <th class="py-3">category</th>
                            <th class="py-3">actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5">
                                    <div class="text-muted">
                                        <i class="fas fa-box fa-3x mb-3 text-black-50"></i>
                                        <h5 class="fw-bold">no products found</h5>
                                        <p>start by adding a new product to your store.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model) {
                                <tr class="border-bottom">
                                    <td class="py-3 px-4">
                                        @if (!string.IsNullOrEmpty(item.Img))
                                        {
                                            <img src="@item.Img" alt="@item.Name" class="rounded shadow-sm" style="width: 60px; height: 60px; object-fit: cover; border: 2px solid #f8f9fa;" />
                                        }
                                        else
                                        {
                                            <div class="bg-light rounded d-flex align-items-center justify-content-center text-muted shadow-sm" style="width: 60px; height: 60px; margin: 0 auto; border: 2px solid #e9ecef;">
                                                <i class="fas fa-image fa-lg"></i>
                                            </div>
                                        }
                                    </td>
                                    
                                    <td class="fw-bold text-dark">
                                        @item.Name
                                    </td>
                                    
                                    <td class="text-muted" style="max-width: 250px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@item.Descrption">
                                        @item.Descrption
                                    </td>
                                    
                                    <td>
                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 fs-6 border border-success">
                                            $@item.Price
                                        </span>
                                    </td>
                                    
                                    <td>
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-2 border border-secondary">
                                            @(item.Category?.Name ?? "N/A")
                                        </span>
                                    </td>
                                    
                                    <td>
                                        <div class="btn-group shadow-sm" role="group" style="border-radius: 8px; overflow: hidden;">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm px-3" title="edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm px-3" title="details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm px-3" title="delete">
                                                <i class="fas fa-trash-alt"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
