@model IEnumerable<ecommerce_system.Models.Proudect>

@{
    ViewData["Title"] = "Products List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (ViewBag.FilteredCategory != null)
{
    <div style="margin-bottom: 20px; padding: 10px; background: rgba(99, 102, 241, 0.1); border-left: 4px solid #6366f1; color: #6366f1;">
        Showing products for category: <strong>@ViewBag.FilteredCategory</strong>
        <a asp-action="Index" style="margin-left: 20px; text-decoration: underline; color: #6366f1;">Clear Filter</a>
    </div>
}

<link rel="stylesheet" href="~/css/voltex_pro.css" />
<link rel="stylesheet" href="~/css/categories.css" />

<div class="page-wrap">
    <div class="breadcrumb reveal">
        <span class="bc-current">Products</span>
    </div>

    <div class="page-hdr reveal">
        <div>
            <p class="page-eye">Store Management</p>
            <h1 class="page-ttl">PRODUCTS<br>LIST</h1>
        </div>
        <a asp-action="Create" class="btn-primary-v">
            <span>+</span> Add New Product
        </a>
    </div>

    @* ── Search / filter bar ── *@
    <div class="cat-filter-bar reveal">
        <div class="cat-search-wrap">
            <span class="cs-icon">⌕</span>
            <input type="text" id="prodSearch" placeholder="Search products..." class="cat-search-input" />
        </div>
        <div class="cat-sort-wrap">
            <select id="prodSort" class="cat-sort-select">
                <option value="name">Sort: Name A–Z</option>
                <option value="name-desc">Sort: Name Z–A</option>
                <option value="price-asc">Sort: Price: Low to High</option>
                <option value="price-desc">Sort: Price: High to Low</option>
            </select>
        </div>
    </div>

    <div class="v-table-wrap reveal">
        <table class="v-table">
            <thead>
                <tr>
                    <th>Image</th>
                    <th>Product Name</th>
                    <th>Description</th>
                    <th>Price</th>
                    <th>Category</th>
                    <th>Actions</th>
                </tr>
            </thead>
            @* Added ID here for JavaScript targeting *@
            <tbody id="prodTableBody">
                @if (!Model.Any())
                {
                    <tr id="emptyRow">
                        <td colspan="6">
                            <div class="empty-state">
                                <span class="empty-icon">📦</span>
                                <div class="empty-ttl">No Products Found</div>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        @* Added class and data- attributes for filtering/sorting *@
                        <tr class="prod-row"
                            data-name="@item.Name.ToLower()"
                            data-price="@item.Price">
                            <td class="td-img">
                                @if (!string.IsNullOrEmpty(item.Img))
                                {
                                    <img src="@item.Img" alt="@item.Name" />
                                }
                                else
                                {
                                    <div class="img-placeholder">📷</div>
                                }
                            </td>
                            <td class="td-name">@item.Name</td>
                            <td class="td-desc" title="@item.Descrption">@item.Descrption</td>
                            <td><span class="td-price">$@item.Price</span></td>
                            <td><span class="td-cat">@(item.Category?.Name ?? "N/A")</span></td>
                            <td>
                                <div class="act-group">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="act-btn edit" title="Edit">✏</a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="act-btn view" title="Details">◉</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="act-btn del" title="Delete">✕</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @* Message shown when search finds nothing *@
    <div id="prodNoResults" style="display:none; text-align:center; padding: 40px;">
        <p class="empty-ttl">No matching products found</p>
    </div>
</div>

@section Scripts {
    <script src="~/js/Products.js" asp-append-version="true"></script>
    <script src="~/js/voltex.jss" asp-append-version="true"></script>
}