@model ecommerce_system.ViewModel.ProudectEditViewModel

@{
    ViewData["Title"] = "Edit Product";
}

<div class="container py-5">

    <!-- Page Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="fw-bold text-white mb-1">
                <i class="fas fa-edit text-primary me-2"></i>Edit Product
            </h2>
            <p class="text-white-50 mb-0">Update the details of your product.</p>
        </div>
        <a asp-controller="Proudects" asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Back to Products
        </a>
    </div>

    <!-- Form Card -->
    <div class="card bg-dark border-secondary shadow-lg">
        <div class="card-body p-4">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ExistingImg" id="existingImg" />

                <div class="row g-4">

                    <!-- Left Column: Basic Info + Pricing -->
                    <div class="col-lg-8">

                        <!-- Basic Information -->
                        <div class="card bg-secondary bg-opacity-10 border-secondary mb-4">
                            <div class="card-header border-secondary">
                                <h5 class="card-title mb-0 text-white">
                                    <i class="fas fa-info-circle text-primary me-2"></i>Basic Information
                                </h5>
                            </div>
                            <div class="card-body">

                                <!-- Product Name -->
                                <div class="mb-3">
                                    <label asp-for="Name" class="form-label text-white-50 fw-semibold">
                                        Product Name <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="Name"
                                           class="form-control bg-dark text-white border-secondary"
                                           placeholder="e.g. Quantum Mechanical Keyboard v2" />
                                    <span asp-validation-for="Name" class="text-danger small"></span>
                                </div>

                                <!-- Description -->
                                <div class="mb-0">
                                    <label asp-for="Descrption" class="form-label text-white-50 fw-semibold">
                                        Description <span class="text-danger">*</span>
                                    </label>
                                    <textarea asp-for="Descrption"
                                              class="form-control bg-dark text-white border-secondary"
                                              rows="5"
                                              placeholder="Describe the product features, materials, and specifications..."></textarea>
                                    <span asp-validation-for="Descrption" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Pricing & Category -->
                        <div class="card bg-secondary bg-opacity-10 border-secondary">
                            <div class="card-header border-secondary">
                                <h5 class="card-title mb-0 text-white">
                                    <i class="fas fa-tag text-primary me-2"></i>Pricing &amp; Organization
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="row g-3">

                                    <!-- Price -->
                                    <div class="col-md-6">
                                        <label asp-for="Price" class="form-label text-white-50 fw-semibold">
                                            Price (USD) <span class="text-danger">*</span>
                                        </label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-dark border-secondary text-white-50">$</span>
                                            <input asp-for="Price"
                                                   class="form-control bg-dark text-white border-secondary"
                                                   placeholder="0.00"
                                                   step="0.01"
                                                   min="0.01"
                                                   max="9999.99" />
                                        </div>
                                        <span asp-validation-for="Price" class="text-danger small"></span>
                                    </div>

                                    <!-- Category -->
                                    <div class="col-md-6">
                                        <label asp-for="CategoryId" class="form-label text-white-50 fw-semibold">Category</label>
                                        <select asp-for="CategoryId"
                                                asp-items="ViewBag.CategoryId"
                                                class="form-select bg-dark text-white border-secondary">
                                            <option value="">— Select a category —</option>
                                        </select>
                                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                                    </div>

                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- Right Column: Product Image -->
                    <div class="col-lg-4">
                        <div class="card bg-secondary bg-opacity-10 border-secondary h-100">
                            <div class="card-header border-secondary">
                                <h5 class="card-title mb-0 text-white">
                                    <i class="fas fa-image text-primary me-2"></i>Product Image
                                </h5>
                            </div>
                            <div class="card-body d-flex flex-column">

                                <!-- Preview Area -->
                                <div class="mb-3 text-center">
                                    <div id="imagePreviewWrapper"
                                         class="border border-secondary rounded d-flex align-items-center justify-content-center bg-dark"
                                         style="height: 200px; overflow: hidden;">
                                        <img id="imagePreview"
                                             src="#"
                                             alt="Preview"
                                             class="img-fluid rounded d-none"
                                             style="max-height: 200px; object-fit: contain;" />
                                        <div id="imagePlaceholder" class="text-white-50 text-center p-3">
                                            <i class="fas fa-image fa-3x mb-2 d-block"></i>
                                            <small>Image preview will appear here</small>
                                        </div>
                                    </div>
                                </div>

                                <!-- Upload Input -->
                                <div class="mb-3">
                                    <label asp-for="Upload" class="form-label text-white-50 fw-semibold text-uppercase small tracking-wider">
                                        Update Image (leave empty to keep current)
                                    </label>
                                    <input asp-for="Upload"
                                           type="file"
                                           accept="image/*"
                                           class="form-control bg-dark text-white border-secondary"
                                           id="Upload"
                                           onchange="previewImage(event)" />
                                    <div class="form-text text-white-50 small mt-1">
                                        <i class="fas fa-info-circle me-1"></i>SVG, PNG, JPG or GIF (max 2MB)
                                    </div>
                                    <span asp-validation-for="Upload" class="text-danger small"></span>
                                </div>

                            </div>
                        </div>
                    </div>

                </div>

                <!-- Action Buttons -->
                <hr class="border-secondary mt-4" />
                <div class="d-flex justify-content-end gap-2">
                    <a asp-controller="Proudects" asp-action="Index"
                       class="btn btn-outline-secondary px-4">
                        <i class="fas fa-times me-1"></i>Cancel
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fas fa-save me-1"></i>Save Changes
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const existingImg = document.getElementById('existingImg').value;
            const preview = document.getElementById('imagePreview');
            const placeholder = document.getElementById('imagePlaceholder');

            if (existingImg && existingImg.trim() !== '') {
                preview.src = existingImg;
                preview.classList.remove('d-none');
                placeholder.classList.add('d-none');
            }
        });

        function previewImage(event) {
            const file = event.target.files[0];
            const preview = document.getElementById('imagePreview');
            const placeholder = document.getElementById('imagePlaceholder');
            const existingImg = document.getElementById('existingImg').value;

            if (file && file.type.startsWith('image/')) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    preview.src = e.target.result;
                    preview.classList.remove('d-none');
                    placeholder.classList.add('d-none');
                };
                reader.readAsDataURL(file);
            } else {
                if (existingImg && existingImg.trim() !== '') {
                    preview.src = existingImg;
                    preview.classList.remove('d-none');
                    placeholder.classList.add('d-none');
                } else {
                    preview.src = '#';
                    preview.classList.add('d-none');
                    placeholder.classList.remove('d-none');
                }
            }
        }
    </script>
}
