@* @model ecommerce_system.Models.Proudect *@
@model ecommerce_system.ViewModel.ProudectCreateViewModel

@{
    ViewData["Title"] = "Add New Product";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=Space+Grotesk:wght@300;400;500&family=Bebas+Neue&family=Jost:wght@200;300;400;500&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="~/css/voltex_pro.css" />

<div class="page-wrap">
    <div class="breadcrumb reveal">
        <a asp-action="Index" class="bc-item">Products</a>
        <span class="bc-sep">›</span>
        <span class="bc-current">Add New</span>
    </div>

    <div class="page-hdr reveal">
        <div>
            <p class="page-eye">Store Management</p>
            <h1 class="page-ttl">ADD NEW<br>PRODUCT</h1>
        </div>
    </div>

    <div class="v-card reveal">
        <div class="form-grid">
            <div class="form-panel">
                <div class="form-panel-ttl">Product Details</div>
                <p class="form-panel-sub">Enter the details of the new product</p>

                <form asp-action="Create" enctype="multipart/form-data">
                    <div asp-validation-summary="All" class="v-error-box" style="display:none"></div>

                    <div class="field-wrap">
                        <label asp-for="Name" class="field-lbl">Product Name</label>
                        <input asp-for="Name" class="field-in" placeholder="e.g. Sony WH-1000XM6" />
                        <span asp-validation-for="Name" class="field-error"></span>
                    </div>

                    <div class="field-wrap">
                        <label asp-for="Descrption" class="field-lbl">Description</label>
                        <input asp-for="Descrption" class="field-in" placeholder="Brief product description" />
                        <span asp-validation-for="Descrption" class="field-error"></span>
                    </div>

                    <div class="field-wrap">
                        <label asp-for="Price" class="field-lbl">Price ($)</label>
                        <input asp-for="Price" class="field-in" placeholder="0.00" />
                        <span asp-validation-for="Price" class="field-error"></span>
                    </div>

                    <div class="field-wrap">
                        <label asp-for="CategoryId" class="field-lbl">Category</label>
                        <select asp-for="CategoryId" class="field-in select-v" asp-items="ViewBag.CategoryId">
                            <option value="">-- Select Category --</option>
                        </select>
                    </div>

                    <div class="field-wrap">
                        <label class="field-lbl">Product Image</label>
                        <div class="file-input-wrap">
                            <input type="file" name="upload" id="imageInput" accept="image/*" />
                            <div class="file-input-display">
                                <span class="file-ico">📎</span>
                                <span id="fileLabel">Choose image file...</span>
                            </div>
                        </div>
                        <span id="imageError" class="field-error" style="display:none"></span>
                        <span asp-validation-for="Upload" class="field-error"></span>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn-primary-v">
                            <span>✓</span> Save Product
                        </button>
                        <a asp-action="Index" class="btn-ghost-v">Back to List</a>
                    </div>
                </form>
            </div>

            <div class="preview-panel">
                <span class="preview-lbl">Image Preview</span>
                <div class="preview-box" id="previewBox">
                    <img id="imagePreview" src="#" alt="preview" style="display:none" />
                    <div class="preview-placeholder" id="placeholderText" style="display:flex;flex-direction:column;align-items:center">
                        <span class="p-ico">🖼</span>
                        <p>Select an image to preview</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/voltex.js"></script>
<script>
    initImagePreview('imageInput', 'imagePreview', 'placeholderText', null);

    document.getElementById('imageInput').addEventListener('change', function () {
        const name = this.files[0] ? this.files[0].name : 'Choose image file...';
        document.getElementById('fileLabel').textContent = name;
    });
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        var vs = document.querySelector('[data-valmsg-summary]');
        if (vs && vs.querySelector('li')) vs.style.display = 'block';
    </script>
}
