@model ecommerce_system.Models.Proudect

@{
    ViewData["Title"] ="add new proudect";
}

<div class="container py-5" dir="rtl">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card border-0 shadow-lg" style="border-radius: 15px; overflow: hidden;">
                <form asp-action="Create" enctype="multipart/form-data">
                <div class="row g-0">
                    <!-- Form Side -->
                    <div class="col-md-7 p-4 p-md-5">
                        <div class="text-center mb-4">
                            <h2 class="fw-bold" style="color: #2c3e50;">add new proudect</h2>
                            <p class="text-muted">enter the details of the proudect</p>
                        </div>
                        
                        <form asp-action="Create" enctype="multipart/form-data">
                            <div asp-validation-summary="All" class="text-danger mb-3"></div>

                            <div class="form-floating mb-3">
                                <input asp-for="Name" class="form-control" placeholder="product name" />
                                <label asp-for="Name">product name</label>
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            <div class="form-floating mb-3">
                                <input asp-for="Descrption" class="form-control" placeholder="description" />
                                <label asp-for="Descrption">description</label>
                                <span asp-validation-for="Descrption" class="text-danger"></span>
                            </div>

                            <div class="form-floating mb-3">
                                <input asp-for="Price" class="form-control" placeholder="price" />
                                <label asp-for="Price">price</label>
                                <span asp-validation-for="Price" class="text-danger"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="CategoryId" class="form-label text-muted fw-bold">category</label>
                                <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId">
                                    <option value="">-- select category --</option>
                                </select>
                            </div>
                            <!--Img-->
                            <div class="form-group mb-4">
                                <label class="form-label text-muted fw-bold">product image</label>
                                <input type="file" name="upload" class="form-control" id="imageInput" accept="image/*" />
                                <span id="imageError" class="text-danger d-block mt-1" style="display:none; font-size: 0.875em;"></span>
                                <span asp-validation-for="Img" class="text-danger"></span>
                            </div>

                            <div class="d-grid gap-2 mt-4">
                                <button type="submit" class="btn btn-primary btn-lg" style="border-radius: 10px;">
                                    <i class="fas fa-save me-2"></i> save product
                                </button>
                                <a asp-action="Index" class="btn btn-light" style="border-radius: 10px;">
                                    back to list
                                </a>
                            </div>
                        </form>
                    </div>
                    
                    <div class="col-md-5 d-none d-md-flex bg-light flex-column justify-content-center align-items-center p-4">
                        <h5 class="text-muted mb-4 fw-bold">image preview</h5>
                        <div class="preview-container text-center shadow-sm" style="width: 100%; max-width: 320px; height: 320px; border: 2px dashed #adb5bd; border-radius: 20px; overflow: hidden; display: flex; align-items: center; justify-content: center; background-color: #ffffff; transition: all 0.3s ease;">
                            <!--imagePreview ÇÓÊÚÑÇÖ ÇáÕæÑå -->
                            <img id="imagePreview" src="#" alt="image preview" style="max-width: 100%; max-height: 100%; object-fit: contain; display: none;" />
                            <div id="placeholderText" class="text-muted">
                                <i class="fas fa-cloud-upload-alt fa-4x mb-3 text-secondary"></i>
                                <p class="m-0 fs-5">select image for product</p>
                                <small class="text-black-50">preview will be displayed here</small>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- Action Buttons -->
                <hr class="border-secondary mt-4" />
                <div class="d-flex justify-content-end gap-2">
                    <a asp-controller="Proudects" asp-action="Index"
                       class="btn btn-outline-secondary px-4">
                        <i class="fas fa-times me-1"></i>Cancel
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fas fa-save me-1"></i>Create Product
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

<script src="~/js/voltex.js"></script>
<script>
    initImagePreview('imageInput', 'imagePreview', 'placeholderText', null);

    document.getElementById('imageInput').addEventListener('change', function () {
        const name = this.files[0] ? this.files[0].name : 'Choose image file...';
        document.getElementById('fileLabel').textContent = name;
    });
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.getElementById('imageInput').addEventListener('change', function (event) {
            const file = event.target.files[0];
            //event.target åæ ÇáÚäÕÑ äÝÓæ  ÇáÕæÑå    
            //ÍØíÊ ÕÝÑ ÚÔÇä ÇÐÇ ÍØ ÇßËÑ ãä ÕæÑå  íæÎÏ Ãæá ãáÝ
            const preview = document.getElementById('imagePreview'); // ÇÓÊÚÑÇÖ ÇáÕæÑå 
            const placeholder = document.getElementById('placeholderText');//ÇáäÕ  
            //ÈäÎÝíå ÈÓ ÇÐÇ Ýí ÕæÑå
            const previewContainer = document.querySelector('.preview-container'); //class 

            const errorSpan = document.getElementById('imageError'); 

            if (file) {
                if (!file.type.startsWith('image/')) {  //ÈÎáíå äæÚ ãáÝ jpg Çæ png Çæ jpeg
                    //ÇÐÇ ÛáÙ ÈÏÎá åÇä 
                    errorSpan.textContent = 'please select a valid image file (like jpg, png, jpeg).'; //imageError
                    errorSpan.style.display = 'block'; 
                    
                    event.target.value = ''; //åÇÖ ÚÔÇä äãÓÍ ÇáãáÝ  ÇÐÇ ãÔ ÒÇÈØ 
                    
                    //ÅÚÇÏÉ ÇáÍÇáÉ ÇáÇÝÊÑÇÖíÉ
                    preview.src = '#';
                    preview.style.display = 'none';
                    placeholder.style.display = 'block';
                    previewContainer.style.borderStyle = 'dashed';
                    previewContainer.style.borderColor = '#dc3545'; 
                    
                    return; 
                } 
                else {
                    errorSpan.style.display = 'none';
                    errorSpan.textContent = '';
                }
                ////////////////////////////////////
                const reader = new FileReader();  // obj  ÚÔÇä íÞÑÃ ÇáãáÝ
                reader.onload = function (e) {  //ÈÓ íÎáÕ ÊÍãíá ÇáÕæÑå (ÞÑÇÉ 
                    preview.src = e.target.result;
                    preview.style.display = 'block';
                    placeholder.style.display = 'none'; // ÃÎÝ ÇáäÕ
                    previewContainer.style.borderStyle = 'solid';
                    previewContainer.style.borderColor = '#0d6efd'; 
                } 
                reader.readAsDataURL(file); // åÇÖ ÚÔÇä íÞÑÃ ÇáãáÝ  æíÍæáæ á URL
            } else {
                errorSpan.style.display = 'none';
                preview.src = '#';
                preview.style.display = 'none';
                placeholder.style.display = 'block';
                previewContainer.style.borderStyle = 'dashed';
                previewContainer.style.borderColor = '#adb5bd';
            }
        });
    </script>
}
