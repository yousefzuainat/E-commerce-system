@model ecommerce_system.Models.Proudect

@{
    ViewData["Title"] = Model.Name + " - Details";
}

<div class="container py-5">
    
    <!-- Breadcrumbs -->
    <nav class="d-flex align-items-center gap-2 text-white-50 small mb-4">
        <a asp-action="Index" class="text-white-50 text-decoration-none hover-white">Inventory</a>
        <i class="fas fa-chevron-right" style="font-size: 10px;"></i>
        <a href="#" class="text-white-50 text-decoration-none hover-white">@(Model.Category?.Name ?? "General")</a>
        <i class="fas fa-chevron-right" style="font-size: 10px;"></i>
        <span class="text-white">@Model.Name</span>
    </nav>

    <div class="row g-5">
        <!-- Left Column: Image -->
        <div class="col-lg-7">
            <div class="card bg-dark border-secondary rounded-4 shadow-lg overflow-hidden position-relative">
                @{
                    string imagePath = string.IsNullOrEmpty(Model.Img) ? "/images/placeholder.png" : Model.Img;
                    if (!imagePath.StartsWith("/") && !imagePath.StartsWith("http"))
                    {
                        imagePath = "/" + imagePath;
                    }
                }
                <img src="@imagePath" alt="@Model.Name" class="w-100 object-fit-cover" style="aspect-ratio: 4/3; max-height: 600px;" />
                <button class="btn btn-dark position-absolute top-0 end-0 m-4 rounded-circle bg-opacity-75 border-secondary text-white shadow" style="width: 44px; height: 44px;">
                    <i class="fas fa-search-plus"></i>
                </button>
            </div>
        </div>

        <!-- Right Column: Info & Actions -->
        <div class="col-lg-5 d-flex flex-column">
            
            <!-- Title & Badge -->
            <div class="mb-3">
                <div class="d-inline-block px-3 py-1 rounded-pill bg-success bg-opacity-10 text-success border border-success border-opacity-25 small fw-semibold mb-3">
                    In Stock
                </div>
                <h1 class="fw-bold text-white mb-2" style="font-size: 2.5rem; letter-spacing: -0.02em;">@Model.Name</h1>
                <p class="fs-5 text-white-50 mb-0">Premium @(Model.Category?.Name ?? "Product") Collection</p>
            </div>

            <!-- Price & Rating -->
            <div class="d-flex align-items-end gap-4 mb-4 pb-4 border-bottom border-secondary">
                <span class="fw-bold text-primary" style="font-size: 3rem; line-height: 1; letter-spacing: -0.02em;">$@Model.Price.ToString("0.00")</span>
                <div class="mb-2">
                    <div class="text-warning mb-1 d-flex gap-1" style="font-size: 1.1rem;">
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star-half-alt"></i>
                    </div>
                    <span class="small text-white-50">4.8 (124 Reviews)</span>
                </div>
            </div>

            <!-- Actions -->
            <div class="d-flex gap-3 mb-5">
                <button class="btn btn-primary flex-grow-1 py-3 fw-semibold fs-6 shadow-lg rounded-3 d-flex justify-content-center align-items-center gap-2" style="transition: all 0.3s ease;">
                    <i class="fas fa-shopping-cart"></i> Add to Cart
                </button>
                <button class="btn btn-outline-secondary py-3 px-4 rounded-3 text-white-50 hover-white d-flex justify-content-center align-items-center" style="transition: all 0.3s ease;">
                    <i class="far fa-heart fs-5"></i>
                </button>
            </div>

            <!-- Description -->
            <div class="card bg-secondary bg-opacity-10 border-secondary rounded-4 mb-4 overflow-hidden">
                <div class="card-header border-secondary p-4 bg-transparent d-flex justify-content-between align-items-center cursor-pointer">
                    <h5 class="mb-0 text-white fw-semibold fs-5">Product Description</h5>
                    <i class="fas fa-chevron-up text-white-50"></i>
                </div>
                <div class="card-body p-4 text-white-50 bg-dark bg-opacity-25" style="line-height: 1.8;">
                    @Model.Descrption
                </div>
            </div>

            <!-- Admin Actions -->
            <div class="mt-auto pt-4 d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-3">
                    <i class="fas fa-arrow-left me-2"></i>Back to List
                </a>
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-outline-primary px-4 rounded-3">
                    <i class="fas fa-edit me-2"></i>Edit Product
                </a>
            </div>

        </div>
    </div>
    
    <!-- Bottom Section: Reviews -->
    <div class="row mt-5 pt-4">
        <div class="col-12">
            <div class="card bg-dark border-secondary rounded-4 shadow-lg">
                <div class="card-body p-4 p-md-5">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h3 class="fw-bold text-white mb-0 d-flex align-items-center gap-2">
                            <i class="fas fa-comments text-primary"></i> Recent Reviews
                        </h3>
                        <a href="#" class="text-primary text-decoration-none fw-semibold hover-white">View All</a>
                    </div>
                    
                    <div class="d-flex flex-column gap-3">
                        <!-- Review Item 1 -->
                        <div class="p-4 bg-secondary bg-opacity-10 border border-secondary rounded-3">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuDeEtdP8ZMYzmfXw7RScs0FCEGpZr3Gdccyra7N5dg5VEwjEzd7Xgz1DMmagYO7xMMsPY7b-6YmwWGl2-qa7mqcRTqLQ_YCyeCoghzV9EXWmcjoTlwBK4HekNWokNsVqzKEl1cxeZPilMRAvVqmE0fNZzupXDucPGeWuoqphIdz6zJ0nTLekkBcaxUn_x6SYTRhryFOfno0ddptH3UVrXXiAuzn_wfbY12wHSBCmp0JAZNbHOb_6bzTzCUKzVDfL1yOtRhmRaAUiQ" class="rounded-circle border border-secondary" style="width: 40px; height: 40px; object-fit: cover;" alt="Alex M." />
                                    <div>
                                        <span class="text-white fw-semibold d-block">Alex M.</span>
                                        <span class="text-white-50" style="font-size: 0.75rem;">Verified Buyer</span>
                                    </div>
                                </div>
                                <div class="text-warning small d-flex gap-1">
                                    <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i>
                                </div>
                            </div>
                            <p class="text-white-50 mb-0" style="line-height: 1.6;">"The build quality is exceptional. The tactile feedback from the brown switches combined with the acoustic foam makes typing incredibly satisfying. Worth every penny."</p>
                        </div>
                        
                        <!-- Review Item 2 -->
                        <div class="p-4 bg-secondary bg-opacity-10 border border-secondary rounded-3">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle bg-dark border border-secondary d-flex align-items-center justify-content-center text-white fw-bold" style="width: 40px; height: 40px; background-color: #2e353f !important;">
                                        SJ
                                    </div>
                                    <div>
                                        <span class="text-white fw-semibold d-block">Sarah J.</span>
                                        <span class="text-white-50" style="font-size: 0.75rem;">Verified Buyer</span>
                                    </div>
                                </div>
                                <div class="text-warning small d-flex gap-1">
                                    <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="far fa-star"></i>
                                </div>
                            </div>
                            <p class="text-white-50 mb-0" style="line-height: 1.6;">"Great board, the wireless connection is flawless. Only giving 4 stars because the software for configuring the RGB took a bit to figure out."</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
