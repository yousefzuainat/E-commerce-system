@model IEnumerable<ecommerce_system.Models.Proudect>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nexus Commerce - High-Performance E-commerce Management</title>
    
    <!-- Bootstrap CSS -->
    <link href="~/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Material Symbols -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <!-- Inter Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap" rel="stylesheet"/>
    
    <style>
        body {
            background-color: #0d141d;
            color: #dce3f0;
            font-family: 'Inter', sans-serif;
            -webkit-font-smoothing: antialiased;
        }
        
        .glass-panel {
            background: rgba(31, 41, 55, 0.6);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid #424754;
            transition: all 0.3s ease;
        }
        
        .glass-panel:hover {
            border-color: rgba(173,198,255,0.5);
        }

        .ambient-glow {
            position: absolute;
            top: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 800px;
            height: 800px;
            background: rgba(173, 198, 255, 0.1);
            border-radius: 50%;
            filter: blur(120px);
            pointer-events: none;
            z-index: -10;
        }
        
        .navbar-custom {
            background-color: rgba(25, 32, 41, 0.8);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid #424754;
        }

        .hover-scale {
            transition: transform 0.5s ease;
        }
        
        .glass-panel:hover .hover-scale {
            transform: scale(1.05);
        }

        .btn-custom-primary {
            background-color: #adc6ff;
            color: #002e6a;
            box-shadow: 0 0 20px rgba(173,198,255,0.2);
            transition: all 0.3s ease;
        }
        
        .btn-custom-primary:hover {
            background-color: #d8e2ff;
            box-shadow: 0 0 25px rgba(173,198,255,0.4);
            transform: translateY(-2px);
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100 position-relative z-0">
    
    <!-- TopNavBar -->
    <nav class="navbar navbar-expand-lg navbar-custom sticky-top py-2">
        <div class="container-fluid px-4">
            <a class="navbar-brand fw-bold fs-4" href="#" style="color: #adc6ff;">NexusAdmin</a>
            
            <div class="d-none d-md-flex mx-auto position-relative" style="max-width: 450px; width: 100%;">
                <span class="material-symbols-outlined position-absolute top-50 start-0 translate-middle-y ms-3" style="color: #c2c6d6; font-size: 1.1rem;">search</span>
                <input class="form-control rounded-3 ps-5 text-white" type="search" placeholder="Search..." aria-label="Search" style="background-color: rgba(46, 53, 63, 0.5); border-color: #424754;">
            </div>

            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-link text-decoration-none rounded-circle p-2" style="color: #c2c6d6;">
                    <span class="material-symbols-outlined">notifications</span>
                </button>
                <button class="btn btn-link text-decoration-none rounded-circle p-2" style="color: #c2c6d6;">
                    <span class="material-symbols-outlined">help</span>
                </button>
                <button class="btn btn-link text-decoration-none rounded-circle p-2" style="color: #c2c6d6;">
                    <span class="material-symbols-outlined">settings</span>
                </button>
                <div class="vr d-none d-sm-block mx-2" style="background-color: #424754; width: 1px; height: 32px;"></div>
                <button class="btn p-0 rounded-circle overflow-hidden ms-2 border" style="width: 36px; height: 36px; border-color: #424754;">
                    <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuA8psSr3OhG_DQtdJcu_4d8HmvquzH5RBGnZBacodqUPacEZg18elXSTyxPNDy4rInoIOE3j5Ng2XNsq0hCK96VoraWYsHFtEF0pGlt-WdzkY3WGd6Tp8l-iewK205fbiNFgcFasq4clSnbVTFs2DYEIe5YZOHLnJWzOXRatdNiZWKJFknjy_UPu4N1a_CiC74Zs5rOQYqrgqmnar_oEx-VJuxsGffKzxgKxDvtYlAl5sFumLpXwmcaw9kAiiW_Ks3qbe2ax1jOrA" alt="Administrator Avatar" class="w-100 h-100 object-fit-cover">
                </button>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="flex-grow-1 position-relative overflow-hidden">
        <!-- Background Ambient Glow -->
        <div class="ambient-glow"></div>

        <!-- Hero Section -->
        <section class="container d-flex flex-column align-items-center justify-content-center text-center position-relative z-1" style="padding-top: 6rem; padding-bottom: 6rem; max-width: 1000px;">
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-4" style="background-color: rgba(46, 53, 63, 0.5); border: 1px solid #424754;">
                <span class="rounded-circle" style="width: 8px; height: 8px; background-color: #4edea3;"></span>
                <span class="text-uppercase" style="font-size: 12px; font-weight: 600; color: #c2c6d6; letter-spacing: 0.05em;">Nexus Commerce 2.0 is live</span>
            </div>
            
            <h1 class="fw-bold mb-4" style="font-size: 3rem; color: #dce3f0;">
                High-Performance E-commerce Management. <span class="d-block mt-2" style="color: #adc6ff;">Precision at Scale.</span>
            </h1>
            
            <p class="mb-5 mx-auto" style="font-size: 1.125rem; color: #8c909f; max-width: 700px;">
                Take total control of your data-dense operations. Designed for power users who demand authority, zero friction, and absolute clarity.
            </p>
            
            <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center w-100" style="max-width: 400px;">
                <a href="/Proudects" class="btn btn-custom-primary btn-lg rounded-3 fw-semibold d-flex align-items-center justify-content-center gap-2 w-100">
                    Manage Products
                    <span class="material-symbols-outlined fs-5">arrow_forward</span>
                </a>
                <button class="btn btn-outline-secondary btn-lg rounded-3 fw-semibold d-flex align-items-center justify-content-center gap-2 w-100 text-white" style="border-color: #424754;">
                    <span class="material-symbols-outlined fs-5">play_circle</span>
                    View Demo
                </button>
            </div>
        </section>

        <!-- Featured Hardware Section -->
        <section class="container pb-5 position-relative z-1" style="max-width: 1280px;">
            <div class="d-flex justify-content-between align-items-center mb-5">
                <h2 class="fw-bold m-0" style="font-size: 2rem; color: #dce3f0;">Featured Hardware</h2>
                <a href="/Proudects" class="text-decoration-none d-flex align-items-center gap-1 fw-semibold" style="color: #adc6ff;">
                    View All Shop
                    <span class="material-symbols-outlined fs-6">open_in_new</span>
                </a>
            </div>

            <div class="row g-4">
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model.Take(3)) // Showing up to 3 featured products
                    {
                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="card h-100 glass-panel border-0 text-white overflow-hidden rounded-4">
                                <div class="position-relative overflow-hidden" style="background-color: #232a34; aspect-ratio: 1/1;">
                                    <img src="@(string.IsNullOrEmpty(item.Img) ? "https://via.placeholder.com/400x400?text=No+Image" : item.Img)" class="w-100 h-100 object-fit-cover hover-scale" alt="@item.Name">
                                </div>
                                <div class="card-body d-flex flex-column p-4">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h3 class="card-title fw-bold m-0 fs-5">@item.Name</h3>
                                        <span class="fw-bold fs-5" style="color: #adc6ff;">$@item.Price</span>
                                    </div>
                                    <p class="card-text mb-4" style="color: #c2c6d6; font-size: 0.875rem;">@item.Descrption</p>
                                    <a href="/Proudects/Details/@item.Id" class="btn mt-auto w-100 fw-semibold py-2 d-flex align-items-center justify-content-center gap-2 rounded-3" style="background-color: rgba(173,198,255,0.1); color: #adc6ff; border: 1px solid rgba(173,198,255,0.2); transition: all 0.3s ease;">
                                        <span class="material-symbols-outlined fs-5">shopping_cart</span>
                                        Add to Cart
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center py-5">
                        <p class="text-secondary fs-5">No products currently available.</p>
                        <a href="/Proudects/Create" class="btn btn-custom-primary mt-3">Add First Product</a>
                    </div>
                }
            </div>
        </section>
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
