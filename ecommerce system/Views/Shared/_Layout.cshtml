<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ecommerce_system</title>
    <script type="importmap"></script>

    <link href="~/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="icon" type="image/png" href="~/shopping-cart.png" />
    
    <!-- Google Fonts & Material Symbols -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ecommerce_system.styles.css" asp-append-version="true" />
    <link href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
</head>
<body>
    <div class="main-container">
        <header>
            <nav class="navbar navbar-expand-lg border-bottom" style="border-color: var(--bs-border-color) !important; background-color: var(--bs-dark) !important;">
                <div class="container-fluid px-4">
                    <!-- Brand -->
                    <a class="navbar-brand d-flex align-items-center gap-3" asp-area="" asp-controller="Home" asp-action="Index">
                        <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold" style="width: 32px; height: 32px; background-color: var(--bs-primary); font-size: 14px;">
                            IP
                        </div>
                        <span class="fw-black" style="font-weight: 900; color: var(--bs-primary);">Inventory Pro</span>
                    </a>
                    
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarColor02" aria-controls="navbarColor02" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    
                    <div class="collapse navbar-collapse" id="navbarColor02">
                        <!-- Navigation Links -->
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-4 gap-2">
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "") d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                                    <span class="material-symbols-outlined fs-5">home</span> Home
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Proudects" ? "active" : "") d-flex align-items-center gap-2" asp-area="" asp-controller="Proudects" asp-action="Index">
                                    <span class="material-symbols-outlined fs-5" style="font-variation-settings: 'FILL' 1;">inventory_2</span> Products
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link d-flex align-items-center gap-2" href="#">
                                    <span class="material-symbols-outlined fs-5">category</span> Categories
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link d-flex align-items-center gap-2" href="#">
                                    <span class="material-symbols-outlined fs-5">shopping_cart</span> Orders
                                </a>
                            </li>
                        </ul>
                        
                        <!-- Search & Profile -->
                        <div class="d-flex align-items-center gap-3">
                            <form class="d-flex position-relative">
                                <span class="material-symbols-outlined position-absolute top-50 translate-middle-y ms-3 text-secondary" style="font-size: 18px;">search</span>
                                <input class="form-control bg-body border-secondary text-white ps-5 pe-3 py-2 shadow-none focus-ring focus-ring-primary" type="search" placeholder="Search products..." style="border-radius: 0.5rem;" />
                            </form>
                            
                            <partial name="_LoginPartial" />
                        </div>
                    </div>
                </div>
            </nav>
        </header>
        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Footer -->
    <footer class="text-center text-lg-start bg-dark text-white mt-5 shadow-lg">
        <!-- Section: Social media -->
        <section class="d-flex justify-content-center justify-content-lg-between p-4 border-bottom border-secondary">
            <!-- Left -->
            <div class="me-5 d-none d-lg-block">
                <span class="text-white-50">Get connected with us on social networks:</span>
            </div>
            <!-- Left -->
            <!-- Right -->
            <div>
                <a href="" class="me-4 text-white-50 text-decoration-none hover-white">
                    <i class="fab fa-facebook-f"></i>
                </a>
                <a href="" class="me-4 text-white-50 text-decoration-none hover-white">
                    <i class="fab fa-twitter"></i>
                </a>
                <a href="" class="me-4 text-white-50 text-decoration-none hover-white">
                    <i class="fab fa-google"></i>
                </a>
                <a href="" class="me-4 text-white-50 text-decoration-none hover-white">
                    <i class="fab fa-instagram"></i>
                </a>
                <a href="" class="me-4 text-white-50 text-decoration-none hover-white">
                    <i class="fab fa-linkedin"></i>
                </a>
                <a href="" class="me-4 text-white-50 text-decoration-none hover-white">
                    <i class="fab fa-github"></i>
                </a>
            </div>
            <!-- Right -->
        </section>
        <!-- Section: Social media -->
        <!-- Section: Links  -->
        <section class="">
            <div class="container text-center text-md-start mt-5">
                <!-- Grid row -->
                <div class="row mt-3">
                    <!-- Grid column -->
                    <div class="col-md-3 col-lg-4 col-xl-3 mx-auto mb-4">
                        <!-- Content -->
                        <h6 class="text-uppercase fw-bold mb-4 text-primary">
                            <i class="fas fa-gem me-3"></i>ecommerce_system
                        </h6>
                        <p class="text-white-50">
                            Premium e-commerce platform providing the best products for your needs.
                            Shop with confidence and style.
                        </p>
                    </div>
                    <!-- Grid column -->
                    <!-- Grid column -->
                    <div class="col-md-2 col-lg-2 col-xl-2 mx-auto mb-4">
                        <!-- Links -->
                        <h6 class="text-uppercase fw-bold mb-4">
                            Products
                        </h6>
                        <p>
                            <a href="#!" class="text-white-50 text-decoration-none hover-white">Electronics</a>
                        </p>
                        <p>
                            <a href="#!" class="text-white-50 text-decoration-none hover-white">Fashion</a>
                        </p>
                        <p>
                            <a href="#!" class="text-white-50 text-decoration-none hover-white">Home & Garden</a>
                        </p>
                        <p>
                            <a href="#!" class="text-white-50 text-decoration-none hover-white">Books</a>
                        </p>
                    </div>
                    <!-- Grid column -->
                    <!-- Grid column -->
                    <div class="col-md-3 col-lg-2 col-xl-2 mx-auto mb-4">
                        <!-- Links -->
                        <h6 class="text-uppercase fw-bold mb-4">
                            Useful links
                        </h6>
                        <p>
                            <a href="#!" class="text-white-50 text-decoration-none hover-white">Pricing</a>
                        </p>
                        <p>
                            <a href="#!" class="text-white-50 text-decoration-none hover-white">Settings</a>
                        </p>
                        <p>
                            <a href="#!" class="text-white-50 text-decoration-none hover-white">Orders</a>
                        </p>
                        <p>
                            <a href="#!" class="text-white-50 text-decoration-none hover-white">Help</a>
                        </p>
                    </div>
                    <!-- Grid column -->
                    <!-- Grid column -->
                    <div class="col-md-4 col-lg-3 col-xl-3 mx-auto mb-md-0 mb-4">
                        <!-- Links -->
                        <h6 class="text-uppercase fw-bold mb-4">Contact</h6>
                        <p class="text-white-50"><i class="fas fa-home me-3"></i> New York, NY 10012, US</p>
                        <p class="text-white-50">
                            <i class="fas fa-envelope me-3"></i>
                            info@ecommerce_system.com
                        </p>
                        <p class="text-white-50"><i class="fas fa-phone me-3"></i> + 01 234 567 88</p>
                        <p class="text-white-50"><i class="fas fa-print me-3"></i> + 01 234 567 89</p>
                    </div>
                    <!-- Grid column -->
                </div>
                <!-- Grid row -->
            </div>
        </section>
        <!-- Section: Links  -->
        <!-- Copyright -->
        <div class="text-center p-4" style="background-color: rgba(0, 0, 0, 0.2);">
            <span class="text-white-50">© 2026 Copyright:</span>
            <a class="text-white fw-bold text-decoration-none" asp-area="" asp-controller="Home" asp-action="Index">ecommerce_system</a>
        </div>
        <!-- Copyright -->
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script>
        toastr.options = {
            "closeButton": true,
            "progressBar": true,
            "positionClass": "toast-top-right",
            "timeOut": "4000",
            "extendedTimeOut": "1000",
            "showEasing": "swing",
            "hideEasing": "linear",
            "showMethod": "fadeIn",
            "hideMethod": "fadeOut"
        };
        @if (TempData["success"] != null)
        {
            <text>toastr.success('@Html.Raw(TempData["success"])');</text>
        }
        @if (TempData["error"] != null)
        {
            <text>toastr.error('@Html.Raw(TempData["error"])');</text>
        }
        @if (TempData["warning"] != null)
        {
            <text>toastr.warning('@Html.Raw(TempData["warning"])');</text>
        }
        @if (TempData["info"] != null)
        {
            <text>toastr.info('@Html.Raw(TempData["info"])');</text>
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
