@using Microsoft.AspNetCore.Identity
@using ecommerce_system.Models
@inject SignInManager<AppliactionUser> SignInManager
@inject UserManager<AppliactionUser> UserManager

<ul class="navbar-nav d-flex align-items-center gap-3 mb-0">
@if (SignInManager.IsSignedIn(User))
{
    var user = await UserManager.GetUserAsync(User);
    <li class="nav-item d-flex align-items-center gap-2">
        <button class="btn btn-link text-secondary p-2 text-decoration-none hover-white">
            <span class="material-symbols-outlined">notifications</span>
        </button>
        <button class="btn btn-link text-secondary p-2 text-decoration-none hover-white">
            <span class="material-symbols-outlined">settings</span>
        </button>
        <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuBd9i4h5kC4J4-P-UoUfBWGiP-HT8h-LbJiQj3P5yKHGBpVASMTEfBteKA8g72NIrwsQEToB8XTGjrRM5thmeJarKEm2Q-o4JaovZgNvqmX3jdleSkXgtdIrCwshSS94uwapz9iPbLFCL88nSEdtrxtyghMXphawlV6Qc4S6FbzyG-6p28DUsfRPYHRaTxdVGZCDcFcjw9nrKJvLKmupYaKO1Gr1INN72PEBkFwJdURUC8Th1-ABT_oN0uKl2D_TzMoBOdya3jHgA" alt="User profile" class="rounded-circle border border-secondary object-fit-cover" style="width: 36px; height: 36px;" />
    </li>
    <li class="nav-item">
        <a class="nav-link text-white hover-white d-flex align-items-center gap-2 fw-medium" asp-area="Identity" asp-page="/Account/Manage/Index">
            Hello @(user?.FullName ?? User.Identity?.Name)!
        </a>
    </li>
    <li class="nav-item">
        <form class="form-inline m-0" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="btn btn-outline-danger btn-sm d-flex align-items-center gap-2" style="border-radius: 0.5rem; padding: 0.4rem 0.8rem;">
                <span class="material-symbols-outlined fs-6">logout</span>
                Logout
            </button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="btn btn-outline-light px-4 py-2 fw-semibold d-flex align-items-center gap-2" style="border-radius: 0.5rem;" asp-area="Identity" asp-page="/Account/Login">
            <i class="fas fa-sign-in-alt"></i> Login
        </a>
    </li>
    <li class="nav-item">
        <a class="btn btn-primary text-white px-4 py-2 fw-semibold shadow-sm d-flex align-items-center gap-2" style="border-radius: 0.5rem;" asp-area="Identity" asp-page="/Account/Register">
            <i class="fas fa-user-plus"></i> Register
        </a>
    </li>
}
</ul>
